{
  "name": "hardware",
  "version": "1.2.0",
  "description": "Hardware design workflow: PCB, Firmware, Simulation, Integration",
  "actions": [
    "hardware.generate_firmware",
    "hardware.compile_firmware",
    "hardware.build_project",
    "hardware.flash_firmware",
    "hardware.debug_regs"
  ],
  "artifacts": [
    "PCBLayout",
    "SourceCode",
    "HexBinary",
    "XBINBinary",
    "BuildReport",
    "SimulationReport",
    "RegisterDump",
    "PipelineReport"
  ],
  "validators": [
    "DFMChecker",
    "FCCompliance",
    "CodeValidator",
    "MemoryBoundChecker"
  ],
  "dependencies": {
    "firmware": "./firmware",
    "simulation": "./simulation"
  },
  "integrations": {
    "xjmcu-pipeline": "./integrations/xjmcu-pipeline.ts",
    "morpex-memory": {
      "type": "python",
      "module": "mcu_memory_kb",
      "path": "../../../AstroM/_archive/toolchains/AstroMcu/mcu_memory_kb.py",
      "db": "../../../Morpex/data/memory.db"
    },
    "buildcli": {
      "type": "python",
      "path": "../../../AstroM/_archive/toolchains/AstroMcu/buildcli"
    },
    "astrocli": {
      "type": "python",
      "path": "../../../AstroM/_archive/toolchains/AstroMcu/astrocli"
    }
  },
  "config": {
    "toolchain_path": "../../../AstroM/_archive/toolchains/AstroMcu",
    "memory_db": "../../../Morpex/data/memory.db",
    "yaml_dir": "../../../矽杰微",
    "default_chip": "XC8P9530",
    "default_freq": "8MHz/4T"
  }
}
