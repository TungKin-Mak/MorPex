{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MorPex Studio",
  "version": "0.1.1",
  "identifier": "com.morpex.studio",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "MorPex Studio",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "resources": {
      "../portable/node.exe": "runtime/node.exe",
      "../portable/repo.zip": "runtime/repo.zip"
    },
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  }
}
